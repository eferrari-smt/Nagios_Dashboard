NAGIOS_SSH_HOST=
NAGIOS_SSH_PORT=22
NAGIOS_SSH_USER=
NAGIOS_SSH_KEY_PATH=
NAGIOS_STATUS_DAT_PATH=/usr/local/nagios/var/status.dat
NAGIOS_HOSTS_CFG_PATH=/usr/local/nagios/etc/objects/hosts/
INVENTORY_CSV_PATH=./data/inventory.csv
POLL_INTERVAL_MINUTES=10
DATABASE_PATH=./data/dashboard.db

# Reportes por mail (diario/semanal) — opcional, se omite el envío con un
# warning si falta cualquiera de estos valores.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
REPORT_RECIPIENTS=
REPORT_DAILY_HOUR=8
REPORT_DAILY_MINUTE=0
REPORT_WEEKLY_DAY=mon
REPORT_WEEKLY_HOUR=8
REPORT_WEEKLY_MINUTE=0

# Reporte diario a Teams (vía webhook de Power Automate) — opcional, se omite
# el envío con un warning si TEAMS_WEBHOOK_URL está vacío.
TEAMS_WEBHOOK_URL=
TEAMS_REPORT_MORNING_HOUR=9
TEAMS_REPORT_MORNING_MINUTE=0
TEAMS_REPORT_AFTERNOON_HOUR=16
TEAMS_REPORT_AFTERNOON_MINUTE=30
